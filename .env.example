# Copy this file to .env and fill the values.
# Real secrets must stay only in .env.

# Telegram API credentials from https://my.telegram.org/apps
API_ID=
API_HASH=

# Telegram bot token from @BotFather
OVERSEER_BOT_TOKEN=
# Separate bot used only by RADAR_MODE=spain.
SPAIN_BOT_TOKEN=
ADMIN_ID=

# Groq keys, comma-separated. One key works, 2-3 keys are better.
GROQ_API_KEYS=

# Telegram user sessions generated by login.py.
# Add SESSION_STRING3=..., SESSION_STRING4=... if you add more accounts.
SESSION_STRING1=
SESSION_STRING2=

# Radar mode:
# it = IT Pain Radar (recommended/default).
# margin = legacy marketplace LeadRadar.
# spain = continuous Spain relocation and Saint Petersburg application radar.
RADAR_MODE=it

# Optional separate database for RADAR_MODE=spain.
# SPAIN_DB_PATH=C:\path\to\spain_relocation.db

# Optional. If omitted, IT mode uses data/it_radar.db and leaves scout.db intact.
# DB_PATH=C:\path\to\it_radar.db

# Runtime speed for all modes: safe, fast, or turbo.
# fast is the recommended default.
RADAR_SPEED=fast

# LeadRadar fast mode reads 50 messages/request. Both accounts independently
# receive a random 15-21 requests/60-minute cycle, capped at 21/hour and 240/day.

# How many latest messages miner reads from one chat per pass.
# 1000 finds more old pains, but increases Telegram FloodWait risk.
MINER_MAX_HISTORY=280

# Keep 0 for normal work. Use 1 only when debugging SQL/database behavior.
DB_LOGS=0
